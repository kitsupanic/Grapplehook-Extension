{
  "manifest_version": 3,
  "name": "Grapplehook",
  "version": "0.1.0",
  "description": "Send the YouTube video you're watching to the Grapplehook app.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": [
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*",
    "*://music.youtube.com/*"
  ],
  "action": {
    "default_title": "Send to Grapplehook",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["src/youtubeButton.js"]
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "grapplehook-extension@kitsupanic",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
